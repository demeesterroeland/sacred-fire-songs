# Server Deployment Configuration
# Copy this file to .env on your preview or production server.

# Which version to pull for docker compose (e.g. preview, latest, or feat-237-unified-audio-experience)
# If omitted, defaults to 'preview' in docker-compose.yml
IMAGE_TAG=preview

# Database credentials for self-hosting (required)
POSTGRES_PASSWORD=your-secure-postgres-password
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
ANON_KEY=your-supabase-anon-key
SERVICE_ROLE_KEY=your-supabase-service-role-key

# Client configuration
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

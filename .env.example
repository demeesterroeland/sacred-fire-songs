# Server Deployment Configuration
# Copy this file to .env on your preview or production server.

# Which version to pull for docker compose (e.g. preview, latest, or feat-237-unified-audio-experience)
# If omitted, defaults to 'preview' in docker-compose.yml
IMAGE_TAG=preview

# Database credentials for self-hosting (required)
POSTGRES_PASSWORD=your-secure-postgres-password
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
ANON_KEY=your-supabase-anon-key
SERVICE_ROLE_KEY=your-supabase-service-role-key

# Client configuration
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Public base URL of the app, used for links in emails (required for email in production)
SITE_URL=https://songs.example.org

# Transactional email over SMTP (optional). Leave SMTP_HOST empty to disable email;
# in-app notifications still work. Port 465 uses TLS on connect, others STARTTLS.
# Local Supabase: SMTP_HOST=127.0.0.1 SMTP_PORT=54325 (mailbox UI on :54324).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Sacred Fire Songs <no-reply@example.org>"

# Dev only: extra origins allowed to reach `npm run dev` (comma-separated),
# e.g. to test from a phone on your LAN: ALLOWED_DEV_ORIGINS=<lan-ip>:3000
# ALLOWED_DEV_ORIGINS=
